/target
/script/.venv
/tmp
__pycache__/

# 便携工具链树（仅 dev-env.ps1 跟踪）；机制见 doc/env.md §2.6
/dev/*
!/dev/dev-env.ps1

# nix-direnv 缓存（可再生成，勿提交）
/.direnv

# 本机 Android 覆盖（版本化 NDK + linker）；模板见 .cargo/config.local.toml.example
/.cargo/config.local.toml

# mdbook 构建中间产物（fixtures/mdbook-static/ 为跟踪的 fixture，mdbook-src/book/ 是其生成源，勿提交）
/fixtures/mdbook-src/book/
