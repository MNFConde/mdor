// mdor Android 应用 — 组件图模型 (LikeC4 DSL)
// 再生成命令: likec4 gen mermaid doc -o <输出目录>

specification {
  element actor {
    style {
      shape person
    }
  }
  element system
  element external-system {
    style {
      color muted
    }
  }
  element component
}

model {
  user = actor '用户' {
    description 'Android 用户'
  }

  remoteHtml = external-system '托管静态站点' {
    description 'mdBook 渲染后的 HTML 站点'
  }
  github = external-system 'GitHub' {
    description '仓库源文件 / commit SHA'
  }
  fs = external-system '设备本地存储' {
    description 'library.json / progress.json / 版本快照目录'
  }

  mdor = system 'mdor Android 应用 (Dioxus + WebView)' {
    bookManager = component 'BookManager' {
      technology 'Rust 服务'
      description '书籍生命周期：添加/删除/更新调度'
    }
    sourceRegistry = component 'SourceRegistry' {
      technology 'Rust 服务'
      description '按 URL 探测并注册 SourceAdapter'
    }
    updateService = component 'UpdateService' {
      technology 'Rust 服务'
      description '更新流程编排：对比→快照→迁移'
    }
    positionService = component 'PositionService' {
      technology 'Rust 服务'
      description '阅读位置读写与迁移调用'
    }
    renderService = component 'RenderService' {
      technology 'Rust 服务'
      description '章节内容抽取与 HTML 渲染'
    }
    staticSite = component 'StaticSiteSource' {
      technology 'Rust 插件'
      description '镜像托管 HTML 站点'
    }
    githubSource = component 'GitHubSource' {
      technology 'Rust 插件'
      description '拉取 markdown 源并渲染'
    }
    snapshotMigrator = component 'SnapshotMigrator' {
      technology 'Rust 插件'
      description '位置绑定版本，快照直连迁移'
    }
    versioning = component 'Versioning' {
      technology 'Rust 核心'
      description '版本标识、快照生成、current 指针'
    }
    bookStore = component 'BookStore' {
      technology 'Rust 核心'
      description '书籍文件落地、元数据读写'
    }

    user -> bookManager '浏览/阅读/操作'
    bookManager -> sourceRegistry 'add_book(url): 探测'
    sourceRegistry -> staticSite '静态站点适配'
    sourceRegistry -> githubSource 'GitHub 适配'
    bookManager -> versioning '生成新版本'
    bookManager -> bookStore '读写书籍元数据'
    updateService -> versioning 'check_update / 快照'
    updateService -> snapshotMigrator 'migrate(from,to,pos)'
    positionService -> snapshotMigrator '查询迁移结果'
    positionService -> bookStore '读/写 progress.json'
    versioning -> bookStore '写版本快照'
    renderService -> bookStore '读取章节内容'
  }

  staticSite -> remoteHtml 'HTTP 镜像 (reqwest)'
  githubSource -> github 'API / raw 拉取'
  bookStore -> fs '文件读写'
}

views {
  view component-view of mdor {
    title 'mdor Android 应用 — 组件图 (C4 Component)'
    include *
    autoLayout TopBottom
  }
}
